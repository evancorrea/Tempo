OPENAI_API_KEY=
# Used only by a later, real-analysis milestone. The local vertical slice uses no model calls.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
TEMPO_DATA_DIR=./data
TEMPO_DATABASE_URL=sqlite:///./data/tempo.db
TEMPO_MAX_PDF_BYTES=52428800
TEMPO_MAX_PAGES=80
TEMPO_OCR_QUALITY_THRESHOLD=0.55
TEMPO_MAX_MODEL_CALLS_PER_PAPER=20
TEMPO_MAX_INPUT_TOKENS_PER_PAPER=250000
TEMPO_MAX_OUTPUT_TOKENS_PER_PAPER=30000
TEMPO_ENABLE_GITHUB_README=false
